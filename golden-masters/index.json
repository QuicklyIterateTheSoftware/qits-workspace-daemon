              "$.command.repoId",
              "$.command.agentSessions[*].sessionId"
            ],
            "instants": [
              "$.command.launchedAt",
              "$.command.agentSessions[*].recordedAt"
            ],
            "strings": [],
            "numbers": [],
            "listFilteredTo": null
          }
        }
      ]
    }
  ]
