# A workspace container image: an existing toolchain image with this daemon as its entrypoint.
#
# This is the shape a workspace container actually runs — the toolchain the user's checkout needs,
# with the daemon as PID 1 — assembled from the two halves that own themselves. The toolchain is
# not built here and could not be: it is the monolith's `workspace-base` stage, shared with its app
# image, and reproducing it would put node, maven and a native toolchain in a repo whose rule is
# that a clone alone builds green with no monorepo and no docker.
#
# Build the daemon image first, then layer it:
#
#     docker build -t qits/workspace-daemon:latest -f docker/Dockerfile .
#     docker build -t qits/workspace:native -f docker/Dockerfile.workspace .
#
# What it is for: running the daemon against a real workspace without waiting on the monolith's
# image pipeline. DaemonApiGateIT self-skips unless the image it is given entrypoints to
# `qits-workspace-daemon`, so this is what makes that gate — and the full-chain harness behind it —
# runnable at all:
#
#     cd ../../services/qits-workspaces
#     ./mvnw test -pl service -Dtest=DaemonApiGateIT -Dsurefire.failIfNoSpecifiedTests=false \
#       -Dqits.workspace.image=qits/workspace:native
#
# This is NOT how a workspace image is released. The monolith builds that, and should get the binary
# by COPYing it out of qits/workspace-daemon rather than compiling its own copy — see the header of
# docker/Dockerfile. Two images that both claim to be "the workspace image" is exactly the drift
# that left qits/workspace:latest several capability versions behind.
ARG BASE=qits/workspace:latest
ARG DAEMON_IMAGE=qits/workspace-daemon:latest

FROM ${DAEMON_IMAGE} AS daemon

FROM ${BASE}
COPY --from=daemon /work/qits-workspace-daemon /usr/local/bin/qits-workspace-daemon

# Replaces whatever the base entrypoints to — for the monolith's workspace image that is the same
# binary, one release older. No CMD and no `sleep infinity` fallback: a container whose daemon
# cannot start is not a usable workspace, and should fail visibly rather than idle looking healthy.
ENTRYPOINT ["/usr/local/bin/qits-workspace-daemon"]
